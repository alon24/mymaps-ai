# Copy to .env.local for local development. In GitHub: Settings → Secrets and variables → Actions → Variables.
# All of these are public (they end up in the browser bundle). Secrets live only in Cloudflare.

# Cloudflare Worker URL (AI proxy), e.g. https://mymaps-ai-worker.<you>.workers.dev
VITE_WORKER_URL=

# Google Cloud OAuth client ID (Web application) — needed for Drive sync & sharing
VITE_GOOGLE_CLIENT_ID=

# Google Cloud API key restricted to Drive API + Picker API and your site's referrer
VITE_GOOGLE_API_KEY=
